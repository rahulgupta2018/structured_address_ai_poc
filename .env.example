# ─────────────────────────────────────────────────────────────
# Structured Address AI — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# All variables have sensible defaults in utils/config.py.
# Only override values you need to change.
# ─────────────────────────────────────────────────────────────

# ── LLM Configuration ───────────────────────────────────────

# Ollama server URL (local inference)
# OLLAMA_BASE_URL=http://localhost:11434

# Model identifiers (LiteLLM format)
# LLM_MODEL_DEV=ollama_chat/qwen2.5-coder:14b
# LLM_MODEL_PROD=gemini-2.0-flash
# LLM_MODEL=ollama_chat/qwen2.5-coder:14b

# LLM request timeout in seconds
# LLM_TIMEOUT_SECONDS=120

# Max output tokens per LLM call (thinking models like qwen3.5 need ≥2048)
# LLM_MAX_TOKENS=2048

# Max LLM round-trips per row (tool calls + final answer)
# LLM_MAX_TURNS=2

# Max concurrent LLM calls (match Ollama's OLLAMA_NUM_PARALLEL)
# LLM_CONCURRENCY=2

# ── GeoNames Matching ───────────────────────────────────────

# Minimum fuzzy-match score (0–100)
# FUZZY_MATCH_THRESHOLD=92

# Margin below which two fuzzy scores are considered ambiguous
# FUZZY_AMBIGUITY_MARGIN=5

# ── Batch Processing ────────────────────────────────────────

# Max rows processed simultaneously
# BATCH_CONCURRENCY=4

# Rows per batch — checkpoint is written after each batch.
# Lower = more frequent checkpoints (less data loss on crash).
# Higher = less checkpoint overhead.
# For 32K rows: 500 recommended (~10 min between checkpoints).
# BATCH_SIZE=200

# Rows between checkpoint saves (legacy — BATCH_SIZE is preferred)
# CHECKPOINT_INTERVAL_ROWS=1000

# ── Production API Keys (uncomment when deploying) ──────────

# Google Cloud / Vertex AI (for Gemini models)
# GOOGLE_API_KEY=your-google-api-key
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
