# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Environment files
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data outputs (generated files)
data/output/*.xlsx
data/output/*.csv

# Large GeoNames reference files (originals - too big for GitHub)
data/reference/allCountries.txt
data/reference/alternateNamesV2.txt
data/reference/cities500.txt
data/reference/cities1000.txt
data/reference/cities5000.txt
data/reference/admin1CodesASCII.txt

# Allow compressed/split parts
!data/reference/*.xz
!data/reference/*.xz.part_*

# SQLite database (generated by ETL)
data/database/*.db
data/database/*.db-shm
data/database/*.db-wal

# Keep the output directory
!data/output/.gitkeep

# Logs
*.log

# Test & coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml
