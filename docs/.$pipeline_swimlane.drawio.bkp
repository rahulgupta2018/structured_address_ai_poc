                <mxCell id="s3_decision" value="exact&#xa;match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="990" y="615" width="100" height="80" as="geometry"/>
                </mxCell>
                <!-- Arrow: disambiguate → decision -->
                <mxCell id="arr_dis_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s3_disambig" target="s3_decision" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="s3_yes_label" value="YES&#xa;conf ≥ 0.95" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#007333;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="615" width="80" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="s3_no_label" value="NO" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#CC0000;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="700" width="40" height="30" as="geometry"/>
                </mxCell>

                <!-- Step 3: Tier 3 no match → feeds into decision NO path too -->
                <mxCell id="arr_t3_nomatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=1;strokeColor=#CC0000;dashed=1;fontSize=9;" parent="1" source="s3_tier3" target="s3_decision" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="615" y="785"/>
                            <mxPoint x="1040" y="785"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s3_allnomatch" value="all tiers fail" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontColor=#CC0000;" parent="1" vertex="1">
                    <mxGeometry x="770" y="775" width="80" height="25" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     STEP 4 — Mismatch Detect
                     ════════════════════════════════════════════════════════════ -->
                <mxCell id="s4_task" value="Cross-country&#xa;city-name check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=center;" parent="1" vertex="1">
                    <mxGeometry x="280" y="870" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s4_out" value="mismatch_detected&#xa;suggested_country_code" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="500" y="875" width="150" height="50" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     STEP 5 — Scanner  (with mismatch decision)
                     ════════════════════════════════════════════════════════════ -->

                <!-- Step 5: mismatch_detected? decision at entry -->
                <mxCell id="s5_mm_dec" value="mismatch&#xa;detected?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="230" y="985" width="110" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s5_mm_yes_label" value="YES → suggested_cc FIRST" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#CC0000;" parent="1" vertex="1">
                    <mxGeometry x="350" y="980" width="160" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="s5_mm_no_label" value="NO → country_code only" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#007333;" parent="1" vertex="1">
                    <mxGeometry x="350" y="1035" width="150" height="25" as="geometry"/>
                </mxCell>

                <!-- Step 5: scan task box -->
                <mxCell id="s5_task" value="N-gram tokenize raw_address&#xa;Phase 1: exact n-gram match&#xa;Phase 2: fuzzy (rapidfuzz ≥92)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=0;align=center;" parent="1" vertex="1">
                    <mxGeometry x="520" y="985" width="210" height="60" as="geometry"/>
                </mxCell>
                <!-- Arrow: mismatch dec → scan task -->
                <mxCell id="arr_s5mm_task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s5_mm_dec" target="s5_task" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Step 5: scan_match? decision diamond -->
                <mxCell id="s5_decision" value="scan&#xa;match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="800" y="980" width="100" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="arr_s5_task_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s5_task" target="s5_decision" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="s5_yes_label" value="YES&#xa;conf = 0.80" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#007333;" parent="1" vertex="1">
                    <mxGeometry x="910" y="980" width="80" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="s5_no_label" value="NO" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=1;fontColor=#CC0000;" parent="1" vertex="1">
                    <mxGeometry x="830" y="1065" width="40" height="30" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     STEP 6 — LLM Agent
                     ════════════════════════════════════════════════════════════ -->
                <mxCell id="s6_task" value="LLM Agent&#xa;5 GeoNames tools&#xa;max 5 tool calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=center;" parent="1" vertex="1">
                    <mxGeometry x="280" y="1155" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s6_out" value="llm_result&#xa;(town, street, etc.)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="500" y="1160" width="130" height="50" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     STEP 7 — Revalidate
                     ════════════════════════════════════════════════════════════ -->
                <mxCell id="s7_task" value="GeoNames re-check&#xa;exact + fuzzy match&#xa;hallucination prevention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;align=center;" parent="1" vertex="1">
                    <mxGeometry x="280" y="1275" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="s7_out" value="status&#xa;confidence" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="500" y="1280" width="80" height="50" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     STEP 8 — Persist
                     ════════════════════════════════════════════════════════════ -->
                <mxCell id="s8_task" value="Assemble final_result&#xa;Map status, round confidence&#xa;Join warnings&#xa;Write: Cloud SQL + GCS + review queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;align=center;" parent="1" vertex="1">
                    <mxGeometry x="280" y="1395" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="s8_end" value="final_result" style="shape=doubleArrow;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;direction=south;" parent="1" vertex="1">
                    <mxGeometry x="380" y="1475" width="80" height="40" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     ARROWS  (main pipeline flow)
                     ════════════════════════════════════════════════════════════ -->

                <!-- Step 0 → Step 1 -->
                <mxCell id="arr_0_1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s0_task" target="s1_task" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Step 1 → Step 2 -->
                <mxCell id="arr_1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s1_task" target="s2_task" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Step 2 → Step 3 mismatch decision -->
                <mxCell id="arr_2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s2_task" target="s3_mm_dec" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Step 3 decision YES → Step 8 (Flow 1 bypass) -->
                <mxCell id="arr_3_yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#007333;dashed=0;" parent="1" source="s3_decision" target="s8_task" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1200" y="655"/>
                            <mxPoint x="1200" y="1430"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="flow1_tag" value="Flow 1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#007333;" parent="1" vertex="1">
                    <mxGeometry x="1205" y="1050" width="60" height="30" as="geometry"/>
                </mxCell>

                <!-- Step 3 decision NO → Step 4 -->
                <mxCell id="arr_3_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#CC0000;" parent="1" source="s3_decision" target="s4_task" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1040" y="810"/>
                            <mxPoint x="1040" y="900"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- Step 4 → Step 5 mismatch decision -->
                <mxCell id="arr_4_5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#333333;" parent="1" source="s4_task" target="s5_mm_dec" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Step 5 decision YES → Step 8 (Flow 2 bypass) -->
                <mxCell id="arr_5_yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;strokeWidth=3;strokeColor=#0000CC;dashed=0;" parent="1" source="s5_decision" target="s8_task" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1150" y="1020"/>
                            <mxPoint x="1150" y="1416"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="flow2_tag" value="Flow 2" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#0000CC;" parent="1" vertex="1">
                    <mxGeometry x="1155" y="1200" width="60" height="30" as="geometry"/>
                </mxCell>

                <!-- Step 5 decision NO → Step 6 -->
                <mxCell id="arr_5_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#CC0000;" parent="1" source="s5_decision" target="s6_task" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="850" y="1100"/>
                            <mxPoint x="850" y="1185"/>
                        </Array>
                    </mxGeometry>
                </mxCell>

                <!-- Step 6 → Step 7 -->
                <mxCell id="arr_6_7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#B85450;" parent="1" source="s6_task" target="s7_task" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="flow3_tag" value="Flow 3" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1220" width="60" height="30" as="geometry"/>
                </mxCell>

                <!-- Step 7 → Step 8 -->
                <mxCell id="arr_7_8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#B85450;" parent="1" source="s7_task" target="s8_task" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     FLOW SUMMARY bars
                     ════════════════════════════════════════════════════════════ -->
                <mxCell id="flow1_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;opacity=80;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1520" width="700" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="flow1_label" value="Flow 1:  Step 0 → 1 → 2 → 3 ══════════════════════════════════════════════► 8    (exact match, conf ≥ 0.95)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#007333;" parent="1" vertex="1">
                    <mxGeometry x="210" y="1520" width="680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="flow2_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;opacity=80;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1570" width="900" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="flow2_label" value="Flow 2:  Step 0 → 1 → 2 → 3 → 4 → 5 ═══════════════════════════════════► 8    (scanner, conf = 0.80)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#0000CC;" parent="1" vertex="1">
                    <mxGeometry x="210" y="1570" width="680" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="flow3_bar" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;opacity=80;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1620" width="1100" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="flow3_label" value="Flow 3:  Step 0 → 1 → 2 → 3 → 4 → 5 → 6 → 7 ════════════════════════► 8    (LLM fallback, ≈15% of rows)" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="210" y="1620" width="680" height="30" as="geometry"/>
                </mxCell>

                <!-- ════════════════════════════════════════════════════════════
                     LEGEND
                     ════════════════════════════════════════════════════════════ -->
                <mxCell id="legend_title" value="Legend" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontStyle=5;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1670" width="60" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="legend_green" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="280" y="1675" width="20" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="legend_green_text" value="Deterministic step" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="305" y="1670" width="120" height="30" as="geometry"/>
                </mxCell>
