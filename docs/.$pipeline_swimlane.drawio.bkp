                </mxCell>
                <mxCell id="s3_mm_no_label" value="NO → use country_code only" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=1;fontColor=#007333;" parent="1" vertex="1">
