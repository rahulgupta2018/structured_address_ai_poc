                <!-- Step 3 Disambiguate box -->
                <mxCell id="s3_disambig" value="Disambiguate&#xa;(admin1, region,&#xa;population)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=0;align=center;" parent="1" vertex="1">
                    <mxGeometry x="780" y="625" width="140" height="55" as="geometry"/>
                </mxCell>

                <!-- Arrows: each tier → disambiguate on match -->
                <mxCell id="arr_t1_dis" value="match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;strokeWidth=1;strokeColor=#007333;fontSize=9;fontColor=#007333;" parent="1" source="s3_tier1" target="s3_disambig" edge="1">
