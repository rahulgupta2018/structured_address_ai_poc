                    <mxGeometry x="520" y="715" width="190" height="55" as="geometry"/>
                </mxCell>

                <!-- Arrow: Tier 1 → Tier 2 (no match → try next) -->
                <mxCell id="arr_t1_t2" value="no match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=1;strokeColor=#999999;fontSize=9;fontColor=#999999;" parent="1" source="s3_tier1" target="s3_tier2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Arrow: Tier 2 → Tier 3 (no match → try next) -->
                <mxCell id="arr_t2_t3" value="no match" style="edgeStyle=orthogonalEdgeStyle;rounded=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=1;strokeColor=#999999;fontSize=9;fontColor=#999999;" parent="1" source="s3_tier2" target="s3_tier3" edge="1">
